# CodeTrace AI — Environment Variables
# Copy this file to .env and fill in your values.

# --- AI Provider (optional — app works without it) ---
# Provider: "openai" or "gemini"
AI_PROVIDER=openai
AI_API_KEY=sk-your-key-here
# Model name (provider-specific)
AI_MODEL=gpt-4o

# --- Sandbox ---
# Docker image for sandbox execution
SANDBOX_IMAGE=codetrace-sandbox:latest
# Execution timeout in seconds
EXECUTION_TIMEOUT=5
# Memory limit (Docker format)
EXECUTION_MEMORY=128m
# CPU limit (Docker format)
EXECUTION_CPU=0.5

# --- Server ---
HOST=0.0.0.0
PORT=8000
# Frontend origin for CORS
CORS_ORIGIN=http://localhost:5173
