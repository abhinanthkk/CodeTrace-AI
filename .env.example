# ── CodeTrace AI — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.

# ── Execution Mode ──────────────────────────────────────────────────────
# "docker"     — Docker sandbox (local dev, recommended)
# "subprocess" — Subprocess runner (production / free cloud hosting)
EXECUTION_MODE=docker

# ── Server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:  http://localhost:5173
# Production: https://codetrace-ai.pages.dev
ALLOWED_ORIGINS=http://localhost:5173

# ── Docker Sandbox (used when EXECUTION_MODE=docker) ────────────────────
SANDBOX_IMAGE=codetrace-sandbox:latest
EXECUTION_TIMEOUT=5
EXECUTION_MEMORY=128m
EXECUTION_CPU=0.5

# ── AI Provider (optional — app works without it) ───────────────────────
# Provider: "openai" or "gemini"
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o

# ── Limits ──────────────────────────────────────────────────────────────
MAX_CODE_SIZE=65536
MAX_INPUT_SIZE=65536
MAX_OUTPUT_SIZE=262144
